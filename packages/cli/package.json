{
  "name": "kiro-kit",
  "version": "0.2.1",
  "description": "CLI tool for bootstrapping engineer-grade Kiro IDE workspaces with curated presets.",
  "type": "module",
  "bin": {
    "kiro-kit": "./dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:structural": "vitest run --config vitest.structural.config.ts",
    "clean": "rimraf dist"
  },
  "keywords": [
    "kiro",
    "ide",
    "preset",
    "cli",
    "scaffolding",
    "developer-tools",
    "workspace"
  ],
  "author": "KK-Kiro-Kit Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ihatesea69/kiro-kit.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ihatesea69/kiro-kit#readme",
  "bugs": {
    "url": "https://github.com/ihatesea69/kiro-kit/issues"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "commander": "^12.1.0",
    "diff": "^7.0.0",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "fast-check": "^3.19.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
