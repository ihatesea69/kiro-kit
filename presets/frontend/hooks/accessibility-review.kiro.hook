{
  "enabled": false,
  "name": "Accessibility Review",
  "description": "When a component changes, audit it against WCAG 2.1 AA and report violations.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/components/**/*.{tsx,jsx}"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A component changed. Audit it for WCAG 2.1 AA issues: semantic elements, ARIA correctness, keyboard operability, focus management, color-contrast risks, and alt text. Report concrete violations with the exact fix. Only apply low-risk, obviously-correct fixes."
  }
}
