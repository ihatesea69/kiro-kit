{
  "enabled": false,
  "name": "Bundle Size Guard",
  "description": "When app code changes, flag heavy or duplicate imports that could bloat the bundle.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.{ts,tsx}",
      "app/**/*.{ts,tsx}"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "App code changed. Inspect new imports for bundle-size risks: full-library imports that should be tree-shaken or deep-imported, heavy dependencies (moment, lodash, large icon sets), and duplicate functionality already present. Report each risk with a lighter alternative. Do not refactor automatically."
  }
}
