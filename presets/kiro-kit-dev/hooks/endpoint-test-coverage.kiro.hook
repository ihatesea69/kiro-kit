{
  "enabled": false,
  "name": "Endpoint Test Coverage",
  "description": "When a new endpoint is added, scaffold integration tests for its success and error paths.",
  "version": "1",
  "when": {
    "type": "fileCreated",
    "patterns": [
      "**/routes/**/*.{ts,js,py,go}",
      "**/controllers/**/*.{ts,js}"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A new endpoint was added. Scaffold integration tests covering the happy path plus auth failures, validation errors, and not-found cases, asserting status codes and response shapes. Use the project's existing test framework and helpers."
  }
}
