{
  "enabled": false,
  "name": "Secret Scan Before Write",
  "description": "Before a file write, scan the pending content for hardcoded secrets and block if any are found.",
  "version": "1",
  "when": {
    "type": "preToolUse"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Before this file write proceeds, inspect the pending content for hardcoded secrets: API keys, access tokens, passwords, private keys, and database connection strings with embedded credentials. If any are found, block the write and report the exact location plus a safe alternative (environment variable via .env). If none are found, allow the write to proceed."
  }
}
