{
  "enabled": false,
  "name": "Experiment Log",
  "description": "When a notebook or training script changes, append a structured experiment log entry.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.ipynb",
      "**/train*.py",
      "**/experiments/**/*.py"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A notebook or training script changed. Append a structured entry to the experiment log (experiments/EXPERIMENTS.md or similar): date, hypothesis, dataset/version, key hyperparameters, metrics, and a one-line conclusion. Only edit the experiment log."
  }
}
