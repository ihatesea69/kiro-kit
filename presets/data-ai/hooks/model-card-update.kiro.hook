{
  "enabled": false,
  "name": "Model Card Update",
  "description": "Manual model-card refresh capturing metrics, data, and intended use.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Update (or create) the model card: model version, training data and date, evaluation metrics with thresholds, intended use and out-of-scope uses, known limitations and bias considerations, and monitoring/retraining triggers. Pull metrics from the latest experiment log where available."
  }
}
