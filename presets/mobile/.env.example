# Project-level environment variables
# Copy this file to .env and fill in your values.

# Workspace root path (auto-detected by CLI)
# WORKSPACE_ROOT=/path/to/project

# API keys for external services
# OPENAI_API_KEY=<your-openai-api-key>
# ANTHROPIC_API_KEY=<your-anthropic-api-key>

# Flutter/Dart specific
# FLUTTER_SDK_PATH=/path/to/flutter
# DART_SDK_PATH=/path/to/dart-sdk

# React Native specific (if applicable)
# REACT_NATIVE_PACKAGER_HOSTNAME=localhost

# Firebase (optional)
# FIREBASE_PROJECT_ID=<your-firebase-project-id>
# FIREBASE_API_KEY=<your-firebase-api-key>

# App Store / Play Store (CI/CD)
# APPLE_ID=<your-apple-id>
# APP_STORE_CONNECT_API_KEY=<your-api-key>
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=<path-to-json>

# Application environment
# APP_ENV=development
