# Skills environment variables
# Copy to .env and fill in values as needed.

# AI/ML API keys (for ai-multimodal skill)
# GEMINI_API_KEY=<your-gemini-api-key>
# OPENAI_API_KEY=<your-openai-api-key>

# Documentation search (for docs-seeker skill)
# DOCS_SEARCH_API_KEY=<your-api-key>

# Chrome DevTools (for chrome-devtools skill)
# PUPPETEER_EXECUTABLE_PATH=/path/to/chromium
