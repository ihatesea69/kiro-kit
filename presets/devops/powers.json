      "description": "Infrastructure as code across cloud providers",
      "tier": "essential",
      "category": "infra",
      "auth": "apiKey",
      "envVars": [
        "TF_API_TOKEN"
      ]
    },
    {
      "name": "Datadog",
      "url": "https://kiro.dev/powers/datadog",
      "description": "Metrics, logs, traces, and dashboards",
      "tier": "recommended",
      "category": "observability",
      "auth": "apiKey",
      "envVars": [
        "DD_API_KEY",
        "DD_APP_KEY"
      ]
    },
    {
      "name": "Snyk",
      "url": "https://kiro.dev/powers/snyk",
      "description": "Dependency and container vulnerability scanning",
      "tier": "recommended",
      "category": "testing",
      "auth": "apiKey",
      "envVars": [
        "SNYK_TOKEN"
      ]
    },
    {
      "name": "Depot",
      "url": "https://kiro.dev/powers/depot",
      "description": "Fast remote container image builds",
      "tier": "recommended",
      "category": "infra",
      "auth": "apiKey",
      "envVars": [
        "DEPOT_TOKEN"
      ]
    },
    {
      "name": "Context7",
      "url": "https://kiro.dev/powers/context7",
      "description": "Up-to-date library and framework documentation lookup",
      "tier": "recommended",
      "category": "docs",
      "auth": "none",
      "mcpBacked": true
    },
    {
      "name": "Harness",
      "url": "https://kiro.dev/powers/harness",
      "description": "CI/CD, feature flags, and deployment automation",
