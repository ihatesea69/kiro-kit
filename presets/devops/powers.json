      "category": "infra",
      "auth": "apiKey",
      "envVars": [
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY"
      ]
    },
    {
      "name": "Pulumi",
      "url": "https://kiro.dev/powers/pulumi",
      "description": "Infrastructure as code in general-purpose languages",
      "tier": "optional",
      "category": "infra",
      "auth": "apiKey",
      "envVars": [
        "PULUMI_ACCESS_TOKEN"
      ]
    },
    {
      "name": "Grafana",
      "url": "https://kiro.dev/powers/grafana",
      "description": "Observability dashboards over metrics and logs",
      "tier": "optional",
      "category": "observability",
      "auth": "apiKey",
      "envVars": [
        "GRAFANA_API_KEY"
      ]
    }
