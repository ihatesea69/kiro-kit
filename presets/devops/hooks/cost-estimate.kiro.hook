{
  "enabled": false,
  "name": "Cost Estimate",
  "description": "Manual infrastructure cost estimate for the current IaC.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Estimate the monthly cost of the infrastructure defined in this workspace's IaC. Break down by resource type, flag the top cost drivers, and suggest concrete savings (right-sizing, spot/reserved, autoscaling floors, storage tiers). State assumptions and note where a real pricing API would refine the estimate."
  }
}
