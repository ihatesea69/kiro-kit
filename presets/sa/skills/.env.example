# Skills environment variables
# Copy relevant variables to your .env file

# AI/LLM API Keys (for ai-multimodal skill)
# GOOGLE_AI_API_KEY=<your-gemini-api-key>
# OPENAI_API_KEY=<your-openai-api-key>

# Container Registry (for container-security skill)
# DOCKER_REGISTRY=<your-registry-url>
# TRIVY_SEVERITY=CRITICAL,HIGH

# Terraform Cloud (for terraform-modules skill)
# TF_CLOUD_TOKEN=<your-terraform-cloud-token>
# TF_VAR_environment=development
