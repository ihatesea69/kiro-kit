{
  "enabled": false,
  "name": "Terraform Plan Review",
  "description": "When Terraform changes, summarize the plan risks before apply.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.tf",
      "**/*.tfvars"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Terraform configuration changed. Summarize the likely plan impact and flag risky changes: resource replacement/destruction, security-group or IAM widening, public exposure, and unversioned/unpinned providers or modules. Report each risk with the safer approach. Do not run apply."
  }
}
