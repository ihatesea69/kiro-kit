# Keep pnpm's virtual-store directory names short.
#
# The docs app (apps/docs) is bundled by Turbopack, which is Rust and does not
# use Windows extended-length paths. pnpm's default virtual-store-dir-max-length
# of 120 pushes real paths for packages with many peer deps (fumadocs-core,
# fumadocs-ui) past the 260-char MAX_PATH limit, and Turbopack then reports them
# as "Module not found" even though Node resolves them fine.
virtual-store-dir-max-length=40
