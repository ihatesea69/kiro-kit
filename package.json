{
  "name": "kk-kiro-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KK-Kiro-Kit monorepo: the kiro-kit npm CLI plus the presets it ships.",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "packages/*",
    "presets/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "clean": "pnpm -r --if-present run clean",
    "docs:dev": "pnpm --filter @kiro-kit/docs run docs:dev",
    "docs:build": "pnpm --filter @kiro-kit/docs run docs:build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ihatesea69/kiro-kit.git"
  },
  "homepage": "https://github.com/ihatesea69/kiro-kit#readme",
  "bugs": {
    "url": "https://github.com/ihatesea69/kiro-kit/issues"
  }
}
